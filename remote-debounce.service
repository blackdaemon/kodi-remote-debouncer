[Unit]
Description=Debounce proxy for the OSMC remote dongle
After=local-fs.target systemd-udevd.service

[Service]
EnvironmentFile=/etc/default/remote-debounce
ExecStart=/usr/local/bin/remote-debounce --debounce-ms ${DEBOUNCE_MS} --vid ${VID} --pid ${PID}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
